<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- ============================= -->
  <!-- Package Sources -->
  <!-- ============================= -->
  <packageSources>
    <!-- حذف همه سورس‌های پیش‌فرض (nuget.org و ...) -->
    <clear />

    <!-- سورس آفلاین (فولدر محلی پکیج‌ها) -->
    <!-- مسیر relative است تا روی هر ماشینی کار کند -->
    <add key="offline-packages" value="./.offline-nuget/packages" />
  </packageSources>

  <!-- ============================= -->
  <!-- Disabled Online Sources -->
  <!-- ============================= -->
  <disabledPackageSources>
    <add key="nuget.org" value="true" />
  </disabledPackageSources>

  <!-- ============================= -->
  <!-- Restore Settings -->
  <!-- ============================= -->
  <restore>
    <!-- اجازه نده اگر پکیجی نبود، دنبال اینترنت بگردد -->
    <ignoreFailedSources>true</ignoreFailedSources>

    <!-- restore فقط از cache محلی -->
    <noCache>false</noCache>
  </restore>

  <!-- ============================= -->
  <!-- Global Packages Folder -->
  <!-- ============================= -->
  <config>
    <!-- محل ذخیره global-packages -->
    <!-- باعث می‌شود همه پکیج‌ها کنار سورس قابل حمل باشند -->
    <add key="globalPackagesFolder" value="./.offline-nuget/packages" />
  </config>

  <!-- ============================= -->
  <!-- Package Management -->
  <!-- ============================= -->
  <packageManagement>
    <!-- فرمت جدید csproj -->
    <add key="format" value="0" />
    <!-- Dependency resolution مدرن -->
    <add key="dependencyVersion" value="Lowest" />
  </packageManagement>

  <!-- ============================= -->
  <!-- Trusted Signers (اختیاری ولی مفید) -->
  <!-- ============================= -->
  <trustedSigners>
    <!-- اگر بعداً nuget.org را فعال کردی -->
    <author name="Microsoft">
      <certificate fingerprint="3F9001EA83C560D712C24CF213C3D312CB3BFFB4"
                   hashAlgorithm="SHA256"
                   allowUntrustedRoot="true" />
    </author>
  </trustedSigners>

</configuration>
